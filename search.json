---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 160 | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | truncate: 800 | jsonify }},
    "description": {{ post.description | default: "" | strip_html | strip_newlines | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tags": {{ post.tags | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
